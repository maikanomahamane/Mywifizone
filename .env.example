# Variables lues par docker-compose et injectées dans les conteneurs PHP.
# Copier vers .env : cp .env.example .env   (ne jamais committer .env)

APP_PORT=8080

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mywifizone
DB_USERNAME=mywifizone
DB_PASSWORD=change-me-locally

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Durées d'authentification (valeurs par défaut, voir config/wifizone.php)
WIFIZONE_ACCESS_TTL_MINUTES=15
WIFIZONE_REFRESH_TTL_DAYS=30
# Essai gratuit : 14 jours (confirmé). Surchargeable par plan depuis le Super Admin.
WIFIZONE_TRIAL_DAYS=14

# Paiements (Phase 2). Le fournisseur mock est FICTIF : dev/tests uniquement, jamais en production.
# Routeurs en connexion directe : VRAI seulement si le serveur joint les routeurs par un réseau privé (VPN) et que les clients sont de confiance.
ROUTER_REST_ALLOW_PRIVATE=false

PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_WEBHOOK_SECRET=change-me-dev-only
WIFIZONE_GRACE_DAYS=3
WIFIZONE_DEFAULT_PLAN=STARTER
