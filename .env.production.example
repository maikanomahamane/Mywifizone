# Production — copier vers .env.production sur le SERVEUR (jamais dans Git, jamais dans l'application mobile).
# Générer chaque secret : openssl rand -hex 32   (APP_KEY : php artisan key:generate --show)

APP_NAME="MY WIFIZONE"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # base64:... ; NE PAS CHANGER après mise en service (données chiffrées)
APP_URL=https://api.example.com
APP_DOMAIN=api.example.com    # lu par Caddy (certificat HTTPS automatique)
APP_VERSION=1.0.0
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*             # le seul proxy devant l'application est Caddy (réseau Docker privé)

LOG_CHANNEL=json              # une ligne JSON par événement, sur stderr (request_id, tenant_id)
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mywifizone
DB_USERNAME=mywifizone
DB_PASSWORD=                  # long et aléatoire

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # long et aléatoire (Redis refuse de démarrer sans)

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# Exploitation
METRICS_TOKEN=                # jeton Bearer de GET /api/v1/internal/metrics (vide = endpoint désactivé)
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE_FILE=       # chemin DANS le conteneur backup d'un fichier contenant la phrase de chiffrement (optionnel)

# Paiements : le fournisseur fictif est refusé en production (même s'il était activé ici).
PAYMENT_MOCK_ENABLED=false
PAYMENT_MOCK_WEBHOOK_SECRET=
# Wave, Nita, Airtel Money, carte : à renseigner UNIQUEMENT quand l'adaptateur aura été branché
# sur la documentation officielle du fournisseur (voir docs/payment-adapter-guide.md).

# Règles métier
WIFIZONE_TRIAL_DAYS=14
WIFIZONE_GRACE_DAYS=3
WIFIZONE_DEFAULT_PLAN=STARTER

# Alertes (php artisan monitor:check, toutes les 5 minutes) — 0 = alerter dès le premier cas
ALERT_NEEDS_ATTENTION_MAX=0
ALERT_STUCK_PAYMENTS_MAX=0
ALERT_OFFLINE_RATIO_MAX=0.5
